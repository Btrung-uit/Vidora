<UserControl x:Class="Vidora.Features.Download.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:download="clr-namespace:Vidora.Features.Download"
             xmlns:models="clr-namespace:Vidora.Core.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="520"
             d:DesignWidth="700"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="28"
                   FontWeight="SemiBold"
                   Text="{DynamicResource Download.Title}" />

        <Grid Grid.Row="1" Margin="0,20,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox MinHeight="36"
                     Padding="10,6"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="{DynamicResource Download.UrlLabel}"
                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="16,6"
                    Command="{Binding PasteCommand}"
                    Content="{DynamicResource Download.Paste}" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="16,6"
                    Command="{Binding DiscoverCommand}"
                    Content="{DynamicResource Download.Discover}" />
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.SecondaryBrush}"
                       Text="{DynamicResource Download.EmptyHint}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static download:DownloadDiscoveryState.Empty}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static download:DownloadDiscoveryState.Discovering}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ProgressBar Width="240" Height="6" IsIndeterminate="True" />
                <TextBlock Margin="0,12,0,12"
                           HorizontalAlignment="Center"
                           Text="{DynamicResource Download.Discovering}" />
                <Button HorizontalAlignment="Center"
                        Padding="16,6"
                        Command="{Binding CancelDiscoveryCommand}"
                        Content="{DynamicResource Download.CancelDiscovery}" />
            </StackPanel>

            <Border Padding="20" CornerRadius="8" BorderBrush="{DynamicResource Border.Brush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static download:DownloadDiscoveryState.Ready}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Height="135" Stretch="UniformToFill" Source="{Binding Metadata.ThumbnailUrl}" />
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Metadata.Title}" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding Metadata.Author}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Metadata.Platform}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Metadata.Duration}" />
                        <TextBlock Margin="0,14,0,4" Text="{DynamicResource Download.Quality}" />
                        <ComboBox ItemsSource="{Binding QualityPresets}"
                                  SelectedItem="{Binding SelectedQuality}" />
                        <TextBlock Margin="0,12,0,4" Text="{DynamicResource Download.Destination}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox IsReadOnly="True" Text="{Binding DestinationDirectory}" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="12,4"
                                    Click="ChooseFolder_Click"
                                    Content="{DynamicResource Download.ChooseFolder}" />
                        </Grid>
                        <Button Margin="0,14,0,0"
                                Padding="16,6"
                                HorizontalAlignment="Left"
                                Command="{Binding StartDownloadCommand}"
                                Content="{DynamicResource Download.Start}" />
                        <StackPanel Margin="0,14,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ProgressBar Height="8" Maximum="100" Value="{Binding Progress.Percent}" />
                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Download.Bytes}" />
                                <TextBlock Margin="4,0,12,0" Text="{Binding Progress.DownloadedBytes}" />
                                <TextBlock Text="{DynamicResource Download.Speed}" />
                                <TextBlock Margin="4,0,12,0" Text="{Binding Progress.BytesPerSecond}" />
                                <TextBlock Text="{DynamicResource Download.Eta}" />
                                <TextBlock Margin="4,0,0,0" Text="{Binding Progress.Eta}" />
                            </StackPanel>
                            <Button Margin="0,8,0,0"
                                    Padding="12,4"
                                    HorizontalAlignment="Left"
                                    Command="{Binding CancelDownloadCommand}"
                                    Content="{DynamicResource Download.Cancel}" />
                        </StackPanel>
                        <StackPanel x:Name="DownloadResultPanel" Margin="0,14,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Completed}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Cancelled}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Failed}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock x:Name="DownloadStatusText" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource Download.Status.Failed}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Completed}">
                                                <Setter Property="Text" Value="{DynamicResource Download.Status.Completed}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Cancelled}">
                                                <Setter Property="Text" Value="{DynamicResource Download.Status.Cancelled}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DownloadError.UserMessageKey}" Value="Error.QualityUnavailable">
                                                <Setter Property="Text" Value="{DynamicResource Error.QualityUnavailable}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DownloadError.UserMessageKey}" Value="Error.DestinationUnavailable">
                                                <Setter Property="Text" Value="{DynamicResource Error.DestinationUnavailable}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DownloadError.UserMessageKey}" Value="Error.DependencyInvalid">
                                                <Setter Property="Text" Value="{DynamicResource Error.DependencyInvalid}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DownloadError.UserMessageKey}" Value="Error.FinalOutputMissing">
                                                <Setter Property="Text" Value="{DynamicResource Error.FinalOutputMissing}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DownloadError.UserMessageKey}" Value="Error.OutputOutsideDestination">
                                                <Setter Property="Text" Value="{DynamicResource Error.OutputOutsideDestination}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding DownloadResult.FinalPath}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Completed}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static download:DownloadDiscoveryState.Failed}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{DynamicResource Download.DiscoveryFailed}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <DockPanel Margin="0,0,0,8">
                <TextBlock VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Queue.Title}" />
                <Button x:Name="ResumeQueueButton"
                        DockPanel.Dock="Right"
                        Padding="12,4"
                        Command="{Binding ResumeQueueCommand}"
                        Content="{DynamicResource Queue.Resume}" />
            </DockPanel>
            <ItemsControl x:Name="QueueList" ItemsSource="{Binding QueueItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,6"
                                Padding="10"
                                BorderBrush="{DynamicResource Border.Brush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Request.Metadata.Title}" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding Status}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="{DynamicResource Text.SecondaryBrush}"
                                               Text="{Binding Request.DestinationDirectory}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="DarkOrange"
                                               Text="{DynamicResource Queue.DuplicateWarning}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasDuplicateUrlWarning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Padding="10,4"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.RemovePendingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        Content="{DynamicResource Queue.Remove}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
