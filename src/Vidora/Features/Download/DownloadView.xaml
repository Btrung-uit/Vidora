<UserControl x:Class="Vidora.Features.Download.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:download="clr-namespace:Vidora.Features.Download"
             xmlns:models="clr-namespace:Vidora.Core.Models"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="520"
             d:DesignWidth="700"
             mc:Ignorable="d">
    <UserControl.Resources>
        <download:ResourceKeyConverter x:Key="ResourceKeyConverter" />
    </UserControl.Resources>
    <ScrollViewer x:Name="DownloadScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="480" Height="{Binding ActualHeight, ElementName=DownloadScrollViewer}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="26"
                   FontWeight="SemiBold"
                   Text="{DynamicResource Download.Title}" />

        <Grid Grid.Row="1" Margin="0,20,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox MinHeight="36"
                     Padding="10,6"
                     VerticalContentAlignment="Center"
                     AutomationProperties.Name="{DynamicResource Download.UrlLabel}"
                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="16,6"
                    Command="{Binding PasteCommand}"
                    Content="{DynamicResource Download.Paste}" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="16,6"
                    Command="{Binding DiscoverCommand}"
                    Content="{DynamicResource Download.Discover}" />
        </Grid>

        <ScrollViewer Grid.Row="2"
                      CanContentScroll="False"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.SecondaryBrush}"
                       Text="{DynamicResource Download.EmptyHint}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static download:DownloadDiscoveryState.Empty}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static download:DownloadDiscoveryState.Discovering}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ProgressBar Width="240" Height="6" IsIndeterminate="True" />
                <TextBlock Margin="0,12,0,12"
                           HorizontalAlignment="Center"
                           Text="{DynamicResource Download.Discovering}" />
                <Button HorizontalAlignment="Center"
                        Padding="16,6"
                        Command="{Binding CancelDiscoveryCommand}"
                        Content="{DynamicResource Download.CancelDiscovery}" />
            </StackPanel>

            <Border Padding="20" CornerRadius="12" BorderBrush="{DynamicResource Border.Brush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static download:DownloadDiscoveryState.Ready}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <Image MaxHeight="260"
                           VerticalAlignment="Top"
                           Stretch="Uniform"
                           Source="{Binding Metadata.ThumbnailUrl}" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Metadata.Title}" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding Metadata.Author}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Metadata.Platform}" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Metadata.Duration}" />
                        <TextBlock Margin="0,14,0,4" Text="{DynamicResource Download.Quality}" />
                        <ComboBox ItemsSource="{Binding QualityPresets}"
                                  SelectedItem="{Binding SelectedQuality}" />
                        <TextBlock Margin="0,12,0,4" Text="{DynamicResource Download.Destination}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox IsReadOnly="True" Text="{Binding DestinationDirectory}" />
                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="12,4"
                                    Click="ChooseFolder_Click"
                                    Content="{DynamicResource Download.ChooseFolder}" />
                        </Grid>
                        <StackPanel x:Name="DownloadResultPanel" Margin="0,14,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Completed}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Cancelled}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Failed}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock x:Name="DownloadStatusText" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource Download.Status.Failed}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Completed}">
                                                <Setter Property="Text" Value="{DynamicResource Download.Status.Completed}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Cancelled}">
                                                <Setter Property="Text" Value="{DynamicResource Download.Status.Cancelled}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Failed}">
                                                <Setter Property="Text" Value="{Binding DownloadError.UserMessageKey, Converter={StaticResource ResourceKeyConverter}}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding DownloadError.SuggestedActionKey, Converter={StaticResource ResourceKeyConverter}}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Failed}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding DownloadResult.FinalPath}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Completed}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="CopyDownloadDiagnosticButton"
                                    Margin="0,8,0,0"
                                    Padding="10,4"
                                    HorizontalAlignment="Left"
                                    Command="{Binding CopyDiagnosticCommand}"
                                    CommandParameter="{Binding DownloadError}"
                                    Content="{DynamicResource Diagnostics.Copy}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastDownloadStatus}" Value="{x:Static models:DownloadStatus.Failed}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static download:DownloadDiscoveryState.Failed}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding Error.UserMessageKey, Converter={StaticResource ResourceKeyConverter}}" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding Error.SuggestedActionKey, Converter={StaticResource ResourceKeyConverter}}" />
                <Button x:Name="CopyDiscoveryDiagnosticButton"
                        Margin="0,8,0,0"
                        Padding="10,4"
                        HorizontalAlignment="Center"
                        Command="{Binding CopyDiagnosticCommand}"
                        CommandParameter="{Binding Error}"
                        Content="{DynamicResource Diagnostics.Copy}" />
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource Warning.ForegroundBrush}"
                       Text="{Binding QueueOperationErrorKey, Converter={StaticResource ResourceKeyConverter}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasQueueOperationError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel x:Name="ActiveDownloadPanel" Margin="0,0,0,12">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ProgressBar Height="8" Maximum="100" Value="{Binding Progress.Percent}"
                             AutomationProperties.Name="{DynamicResource Download.Progress}" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Download.Bytes}" />
                    <TextBlock Margin="4,0,12,0" Text="{Binding Progress.DownloadedBytes}" />
                    <TextBlock Text="{DynamicResource Download.Speed}" />
                    <TextBlock Margin="4,0,12,0" Text="{Binding Progress.BytesPerSecond}" />
                    <TextBlock Text="{DynamicResource Download.Eta}" />
                    <TextBlock Margin="4,0,0,0" Text="{Binding Progress.Eta}" />
                </StackPanel>
                <Button x:Name="CancelActiveDownloadButton"
                        Margin="0,8,0,0"
                        Padding="12,4"
                        HorizontalAlignment="Left"
                        Command="{Binding CancelDownloadCommand}"
                        Content="{DynamicResource Download.Cancel}" />
            </StackPanel>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock VerticalAlignment="Center" Margin="0,0,16,6"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="{DynamicResource Queue.Title}" />
                    <Button x:Name="StartDownloadButton"
                            Margin="0,0,8,6"
                            Padding="12,4"
                            Command="{Binding StartDownloadCommand}"
                            Content="{DynamicResource Download.Start}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static download:DownloadDiscoveryState.Ready}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="ResumeQueueButton"
                            Margin="0,0,8,6"
                            Padding="12,4"
                            Command="{Binding ResumeQueueCommand}"
                            Content="{DynamicResource Queue.Resume}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QueueItems.Count}" Value="0">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="ClearFinishedButton" Margin="0,0,0,6" Padding="12,4"
                            Command="{Binding ClearFinishedCommand}" Content="{DynamicResource Queue.ClearFinished}"
                            ToolTip="{DynamicResource Queue.ClearHint}" />
            </WrapPanel>
            <ScrollViewer x:Name="QueueScrollViewer"
                          MaxHeight="140"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="QueueList" ItemsSource="{Binding QueueItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6"
                                    Padding="10"
                                    BorderBrush="{DynamicResource Border.Brush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Request.Metadata.Title}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Request.Metadata.Title}" />
                                        <TextBlock Margin="0,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource Queue.Status.Pending}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter Property="Text" Value="{DynamicResource Queue.Status.Downloading}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Text" Value="{DynamicResource History.Status.Completed}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Text" Value="{DynamicResource History.Status.Failed}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Text" Value="{DynamicResource History.Status.Cancelled}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Interrupted"><Setter Property="Text" Value="{DynamicResource History.Status.Interrupted}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Warning.ForegroundBrush}"
                                                   Text="{Binding Error.UserMessageKey, Converter={StaticResource ResourceKeyConverter}}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Text.SecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Request.DestinationDirectory}"
                                                   Text="{Binding Request.DestinationDirectory}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Warning.ForegroundBrush}"
                                                   Text="{DynamicResource Queue.DuplicateWarning}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDuplicateUrlWarning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                        <Button x:Name="RetryQueueItemButton" Margin="0,0,8,4" Padding="10,4"
                                                Command="{Binding DataContext.RetryQueueItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Content="{DynamicResource Queue.Retry}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button x:Name="OpenQueueFileButton" Margin="0,0,8,4" Padding="10,4"
                                                Command="{Binding DataContext.OpenQueueFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Content="{DynamicResource History.OpenFile}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Margin="0,0,8,4" Padding="10,4"
                                                Command="{Binding DataContext.OpenQueueFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Content="{DynamicResource History.OpenFolder}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    <Button Margin="0,0,0,4"
                                            Padding="10,4"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{DynamicResource Queue.Remove}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
