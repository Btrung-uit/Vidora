<UserControl x:Class="Vidora.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Vidora.Core.Models">
    <UserControl.Resources>
        <Style x:Key="DependencyStatusStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="{DynamicResource Dependency.Status.Checking}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DependencyStatus.Ready}">
                    <Setter Property="Text" Value="{DynamicResource Dependency.Status.Ready}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DependencyStatus.Missing}">
                    <Setter Property="Text" Value="{DynamicResource Dependency.Status.Missing}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DependencyStatus.Invalid}">
                    <Setter Property="Text" Value="{DynamicResource Dependency.Status.Invalid}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="560">
        <TextBlock Margin="0,0,0,8"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Text="{DynamicResource Settings.Title}" />
        <TextBlock Margin="0,0,0,24"
                   Text="{DynamicResource Dependency.Description}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource Settings.Theme}" />
        <ComboBox x:Name="ThemeSelector" AutomationProperties.Name="{DynamicResource Settings.Theme}"
                  SelectedValuePath="Tag" SelectedValue="{Binding Theme, UpdateSourceTrigger=PropertyChanged}">
            <ComboBoxItem Content="{DynamicResource Settings.Theme.System}" Tag="System" />
            <ComboBoxItem Content="{DynamicResource Settings.Theme.Light}" Tag="Light" />
            <ComboBoxItem Content="{DynamicResource Settings.Theme.Dark}" Tag="Dark" />
        </ComboBox>
        <CheckBox Margin="0,8,0,16" AutomationProperties.Name="{DynamicResource Settings.Notifications}"
                  Content="{DynamicResource Settings.Notifications}"
                  IsChecked="{Binding NotificationsEnabled, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock x:Name="PersistenceRecoveryWarning"
                   Margin="0,0,0,16"
                   Padding="12"
                   Background="#FFFFF4CE"
                   Foreground="#FF7A4E00"
                   Text="{DynamicResource Settings.PersistenceRecoveryWarning}"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPersistenceRecoveryWarning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Margin="0,0,0,12" Padding="16" BorderBrush="#FFD1D5DB" BorderThickness="1" CornerRadius="8">
            <StackPanel DataContext="{Binding Report.YtDlp}">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{DynamicResource Dependency.YtDlp}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource DependencyStatusStyle}" />
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock Margin="0,0,4,0" Text="{DynamicResource Dependency.Version}" />
                    <TextBlock Text="{Binding Version}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,4,0" Text="{DynamicResource Dependency.LatestVersion}" />
                <TextBlock x:Name="LatestYtDlpVersionText" Text="{Binding LatestYtDlpVersion}" />
            </StackPanel>
            <Button x:Name="UpdateYtDlpButton"
                    Margin="0,8,0,0"
                    Padding="12,8"
                    HorizontalAlignment="Left"
                    Content="{DynamicResource Dependency.UpdateYtDlp}"
                    Command="{Binding UpdateYtDlpCommand}" />
            <TextBlock x:Name="UpdateRecoveryText"
                       Margin="0,8,0,0"
                       Foreground="DarkOrange"
                       Text="{DynamicResource Dependency.UpdateRecovery}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUpdateError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Border Margin="0,0,0,16" Padding="16" BorderBrush="#FFD1D5DB" BorderThickness="1" CornerRadius="8">
            <StackPanel DataContext="{Binding Report.Ffmpeg}">
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{DynamicResource Dependency.Ffmpeg}" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource DependencyStatusStyle}" />
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <TextBlock Margin="0,0,4,0" Text="{DynamicResource Dependency.Version}" />
                    <TextBlock Text="{Binding Version}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Button HorizontalAlignment="Left"
                Padding="12,8"
                Content="{DynamicResource Dependency.CheckAgain}"
                Command="{Binding CheckDependenciesCommand}" />
    </StackPanel>
</UserControl>
