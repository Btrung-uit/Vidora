<UserControl x:Class="Vidora.Features.History.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <TextBlock VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Text="{DynamicResource History.Title}" />
            <Button x:Name="ClearHistoryButton"
                    Padding="12,6"
                    HorizontalAlignment="Right"
                    Command="{Binding ClearCommand}"
                    Content="{DynamicResource History.Clear}" />
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Foreground="DarkOrange"
                       Text="{DynamicResource History.PersistenceFailed}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPersistenceError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Foreground="DarkOrange"
                       Text="{DynamicResource History.OperationFailed}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasOperationError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="2">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.SecondaryBrush}"
                       Text="{DynamicResource History.Empty}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryList" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Padding="12"
                                    BorderBrush="{DynamicResource Border.Brush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <StackPanel>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="{Binding Item.Title}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource Text.SecondaryBrush}"
                                               Text="{Binding Item.SourceUrl}" />
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource History.Status}" />
                                        <TextBlock Margin="4,0,16,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource History.Status.Interrupted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Item.Status}" Value="Completed">
                                                            <Setter Property="Text" Value="{DynamicResource History.Status.Completed}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Item.Status}" Value="Failed">
                                                            <Setter Property="Text" Value="{DynamicResource History.Status.Failed}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Item.Status}" Value="Cancelled">
                                                            <Setter Property="Text" Value="{DynamicResource History.Status.Cancelled}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{DynamicResource History.Quality}" />
                                        <TextBlock Margin="4,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource Quality.Best}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Item.Quality}" Value="P1080">
                                                            <Setter Property="Text" Value="{DynamicResource Quality.1080}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Item.Quality}" Value="P720">
                                                            <Setter Property="Text" Value="{DynamicResource Quality.720}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Item.Quality}" Value="P480">
                                                            <Setter Property="Text" Value="{DynamicResource Quality.480}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock x:Name="MissingStatusText"
                                               Margin="0,5,0,0"
                                               Foreground="DarkOrange"
                                               Text="{DynamicResource History.Missing}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="OpenFileButton"
                                                Margin="0,0,8,0"
                                                Padding="10,4"
                                                Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{DynamicResource History.OpenFile}" />
                                        <Button Margin="0,0,8,0"
                                                Padding="10,4"
                                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{DynamicResource History.OpenFolder}" />
                                        <Button Margin="0,0,8,0"
                                                Padding="10,4"
                                                Command="{Binding DataContext.CopyUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{DynamicResource History.CopyUrl}" />
                                        <Button Padding="10,4"
                                                Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{DynamicResource History.Retry}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
